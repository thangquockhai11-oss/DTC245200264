# =======================================================
# Template Environment Configuration for ElectroShop (Đề 9)
# Copy this file to .env and change credentials as needed
# =======================================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=ChangeThisRootSecret2026!
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=shop_user
MYSQL_PASSWORD=ChangeThisUserPassword123!

# Exporter Monitoring Credentials
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=ChangeThisExporterPass123!

# Web Application Configuration
WEB_PORT=3000
NODE_ENV=production

# Grafana Monitoring Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeThisGrafanaAdminPass2026!
GF_USERS_ALLOW_SIGN_UP=false
