      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "title": "Event Loop Lag & Active Handles",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_nodejs_eventloop_lag_seconds{job=\"backend\"}", "legendFormat": "Event Loop Lag (s)", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_nodejs_active_handles_total{job=\"backend\"}", "legendFormat": "Active Handles", "refId": "B" }
      ]
