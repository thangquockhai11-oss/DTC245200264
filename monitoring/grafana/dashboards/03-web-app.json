      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "title": "Node.js Heap Memory Breakdown",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_nodejs_heap_size_used_bytes{job=\"backend\"}", "legendFormat": "Heap Used", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_nodejs_heap_size_total_bytes{job=\"backend\"}", "legendFormat": "Heap Total", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "node_process_resident_memory_bytes{job=\"backend\"}", "legendFormat": "Process RSS", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 15, "lineWidth": 2 }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
