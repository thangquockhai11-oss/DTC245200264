      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "mysql_global_status_innodb_buffer_pool_pages_data", "legendFormat": "Data Pages", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "mysql_global_status_innodb_buffer_pool_pages_free", "legendFormat": "Free Pages", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "mysql_global_status_innodb_buffer_pool_pages_total", "legendFormat": "Total Pages", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 15, "lineWidth": 2 }, "unit": "Bps" },
