      "title": "Trạng Thái MySQL",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "mysql_up", "legendFormat": "Status", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
