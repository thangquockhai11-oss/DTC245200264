      "type": "timeseries",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(mysql_global_status_questions[1m])", "legendFormat": "Questions/sec", "refId": "A" }]
    },
    {
      "collapsed": false,
