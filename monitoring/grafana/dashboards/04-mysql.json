      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(mysql_global_status_commands_total{command=\"select\"}[1m])", "legendFormat": "SELECT", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(mysql_global_status_commands_total{command=\"insert\"}[1m])", "legendFormat": "INSERT", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(mysql_global_status_commands_total{command=\"update\"}[1m])", "legendFormat": "UPDATE", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(mysql_global_status_commands_total{command=\"delete\"}[1m])", "legendFormat": "DELETE", "refId": "D" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 15, "lineWidth": 2 }, "unit": "ops" },
